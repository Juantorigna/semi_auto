<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.campsite.kiosk">

    <!-- ── Permissions ──────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- ACCESS_NETWORK_STATE used by connectivity watchdog in Step 12 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ── Application ──────────────────────────────────────────────────── -->
    <application
        android:name=".KioskApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.KioskApp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hardwareAccelerated="true">

        <!-- ── Main / only Activity ───────────────────────────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustNothing"
            android:immersive="true"
            android:keepScreenOn="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- HOME category enables this app to act as launcher in kiosk mode -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>

    </application>

</manifest>